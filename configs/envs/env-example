# Environment Variables Example
# Скопируйте этот файл в .env-base и заполните значения

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_username
DB_PASSWORD=your_password
DB_NAME=your_database

# JWT Configuration
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256

# Access Token Configuration
ACCESS_TOKEN_COOKIE_NAME=access_token
ACCESS_TOKEN_EXPIRE_MINUTES=30

# OAuth2 Configuration
OATH_GOOGLE_WEB_CLIENT_SECRET=your_google_client_secret
OATH_GOOGLE_WEB_CLIENT_ID=your_google_client_id
OATH_YANDEX_WEB_CLIENT_SECRET=your_yandex_client_secret
OATH_YANDEX_WEB_CLIENT_ID=your_yandex_client_id

# Refresh Token Configuration
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_TOKEN_COOKIE_NAME=refresh_token
MAX_REFRESH_TOKENS_PER_USER=5

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["GET", "POST", "PUT", "DELETE", "OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type", "Authorization", "X-Requested-With"]

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration (optional)
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Telegram Configuration
TG_BOT_TOKEN=your_telegram_bot_token

# Logging Configuration
MODE=DEV
LOG_LEVEL=INFO

# Frontend Configuration
VITE_BACKEND_URL=http://localhost:8000/api/v1
